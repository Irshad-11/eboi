# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" key (or the new "publishable" key). Safe in the browser: RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key (or the new "secret" key). SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Your public site URL, no trailing slash. Used for canonical URLs, sitemap,
# OG images and the link inside WhatsApp messages.
NEXT_PUBLIC_SITE_URL=https://eboi.vercel.app

# Google Search Console > HTML tag method > the content="..." value only.
NEXT_PUBLIC_GSC_VERIFICATION=
